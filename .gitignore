# =====================================================================
# DevCity .gitignore
# Schützt Secrets, Backups, Logs, OS-spezifische Dateien und Memory
# =====================================================================

# --- Secrets & Credentials (NIEMALS committen) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.token
*.secret
secrets.json
credentials.json
*.crt

# --- Backups & Logs (lokal, nicht im Repo) ---
backups/
logs/
*.log
*.bak
*.backup
*.tmp
*.swp
*~

# --- OS-spezifisch ---
# Windows
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk
ehthumbs.db
# macOS
.DS_Store
._*
.AppleDouble
.LSOverride
# Linux
*~
.fuse_hidden*
.Trash-*

# --- IDE / Editoren ---
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
*.sublime-*

# --- Node / npm ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/cache
.yarn/install-state.gz

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Java / Maven ---
target/
*.class
*.jar
*.war
*.ear
hsys_err_pid*.log
hsys_out_pid*.log

# --- Snapshots / Temporäre Setup-Daten ---
*.snapshot.zip
*.tmp.json
.cache/

# --- Memory (lokal) ---
# Memory-Dateien werden lokal gepflegt und NICHT ins Git-Repo gepusht.
# Ausnahme: memory/README.md und memory/.gitkeep sind erlaubt.
memory/*
!memory/README.md
!memory/.gitkeep

# --- Opencode-Session-Daten ---
.opencode/session/
.opencode/cache/